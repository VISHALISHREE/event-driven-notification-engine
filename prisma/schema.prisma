// Prisma schema for the Event-Driven Notification Engine
// Prisma ORM 7.10.1
//
// IMPORTANT:
// - This schema defines the logical data model.
// - Monthly PostgreSQL partitioning for Notification requires a custom SQL migration.
// - Do not run a migration until the schema and partitioning migration have been reviewed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------- ENUMS ----------------

enum Channel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
  IN_APP
}

enum EventType {
  TRANSACTION_SUCCESS
  TRANSACTION_FAILED
  LARGE_TRANSACTION
  LOGIN_ALERT
  PASSWORD_CHANGED
  SIP_DUE
  SIP_SUCCESS
  SIP_FAILED
  MARGIN_CALL
  PRICE_ALERT
  PORTFOLIO_UPDATE
  ORDER_PLACED
  ORDER_EXECUTED
  ORDER_REJECTED
  KYC_PENDING
  KYC_APPROVED
  KYC_REJECTED
  DIVIDEND_CREDITED
  IPO_UPDATE
  REGULATORY_NOTICE
  ACCOUNT_STATEMENT_READY
  PAYMENT_DUE
  WITHDRAWAL_SUCCESS
  WITHDRAWAL_FAILED
  DEPOSIT_SUCCESS
  DEPOSIT_FAILED
  SYSTEM_ANNOUNCEMENT
}

enum EventProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  RETRY_SCHEDULED
  FAILED
  SUPPRESSED
  DEFERRED
  DEAD_LETTER
  CANCELLED
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum ConsentSource {
  USER_ACTION
  API
  ADMIN
  IMPORT
}

enum ConsentPurpose {
  TRANSACTIONAL
  MARKETING
  SECURITY
  REGULATORY
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  DOWN
  DISABLED
}

enum DeliveryAttemptStatus {
  STARTED
  ACCEPTED
  DELIVERED
  FAILED
  UNKNOWN
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DigestFrequency {
  DAILY
  WEEKLY
}

enum DigestDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// ---------------- USERS ----------------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?  @unique
  phone     String?  @unique
  locale    String   @default("en")
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preference      UserPreference?
  consents        ConsentRecord[]
  notifications   Notification[]
  digestSchedules DigestSchedule[]
  frequencyCaps   ChannelFrequencyCap[]

  @@index([isActive])
}

model UserPreference {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  preferredChannels Channel[] @default([])
  quietHoursEnabled Boolean   @default(false)
  quietHoursStart   String?
  quietHoursEnd     String?
  digestEnabled     Boolean   @default(false)
  dailyFrequencyCap Int       @default(5)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChannelFrequencyCap {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  channel    Channel
  dailyLimit Int      @default(5)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([userId, enabled])
}

// ---------------- CONSENT AND DND ----------------

model ConsentRecord {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  channel     Channel
  purpose     ConsentPurpose
  status      ConsentStatus
  source      ConsentSource
  evidenceRef String?
  recordedAt  DateTime       @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, purpose, recordedAt])
  @@index([userId, channel, purpose, status])
}

model DndRegistry {
  id              String    @id @default(uuid()) @db.Uuid
  phoneNumber     String    @unique
  isActive        Boolean   @default(true)
  source          String
  checkedAt       DateTime  @default(now())
  sourceUpdatedAt DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, expiresAt])
}

// ---------------- EVENTS ----------------

model Event {
  id              String                @id @default(uuid()) @db.Uuid
  producer        String
  externalEventId String
  eventType       EventType
  schemaVersion   Int                   @default(1)
  payload         Json
  status          EventProcessingStatus @default(RECEIVED)
  occurredAt      DateTime
  receivedAt      DateTime              @default(now())
  processedAt     DateTime?

  notifications  Notification[]
  outboxMessages OutboxMessage[]

  @@unique([producer, externalEventId])
  @@index([eventType, receivedAt])
  @@index([status, receivedAt])
}

// ---------------- NOTIFICATIONS ----------------

// Composite primary key supports PostgreSQL partitioning by createdAt.
// Related models store both notificationId and notificationCreatedAt.
model Notification {
  id                String             @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  eventId           String             @db.Uuid
  channel           Channel
  status            NotificationStatus @default(PENDING)
  priority          Int                @default(5)
  locale            String             @default("en")
  templateVersionId String?            @db.Uuid
  renderedSubject   String?
  renderedBody      String?
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  retryCount        Int                @default(0)
  maxRetries        Int                @default(3)
  nextRetryAt       DateTime?
  lastError         String?

  user             User                 @relation(fields: [userId], references: [id])
  event            Event                @relation(fields: [eventId], references: [id])
  templateVersion  TemplateVersion?     @relation(fields: [templateVersionId], references: [id])
  attempts         DeliveryAttempt[]
  deliveryEvents   DeliveryEvent[]
  routingDecisions RoutingDecision[]
  digestItems      DigestDeliveryItem[]

  @@id([id, createdAt])
  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@index([eventId])
  @@index([channel, status])
}

// ---------------- DELIVERY HISTORY ----------------

model DeliveryAttempt {
  id                    String                @id @default(uuid()) @db.Uuid
  notificationId        String                @db.Uuid
  notificationCreatedAt DateTime
  providerId            String                @db.Uuid
  attemptNumber         Int
  status                DeliveryAttemptStatus @default(STARTED)
  providerMessageId     String?
  requestMetadata       Json?
  responseMetadata      Json?
  errorCode             String?
  errorMessage          String?
  startedAt             DateTime              @default(now())
  completedAt           DateTime?
  latencyMs             Int?

  notification Notification @relation(fields: [notificationId, notificationCreatedAt], references: [id, createdAt])
  provider     Provider     @relation(fields: [providerId], references: [id])

  @@unique([notificationId, notificationCreatedAt, attemptNumber])
  @@index([providerId, status])
  @@index([notificationId, notificationCreatedAt])
}

model DeliveryEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  notificationId        String   @db.Uuid
  notificationCreatedAt DateTime
  providerId            String?  @db.Uuid
  providerEventId       String?
  eventType             String
  payload               Json?
  occurredAt            DateTime @default(now())

  notification Notification @relation(fields: [notificationId, notificationCreatedAt], references: [id, createdAt])
  provider     Provider?    @relation(fields: [providerId], references: [id])

  @@unique([providerId, providerEventId])
  @@index([notificationId, notificationCreatedAt, occurredAt])
}

// ---------------- TEMPLATES ----------------

model NotificationTemplate {
  id        String    @id @default(uuid()) @db.Uuid
  key       String
  eventType EventType
  channel   Channel
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  versions TemplateVersion[]

  @@unique([key, channel])
}

model TemplateVersion {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  version    Int
  locale     String
  subject    String?
  body       String
  createdAt  DateTime @default(now())

  template      NotificationTemplate @relation(fields: [templateId], references: [id])
  notifications Notification[]

  @@unique([templateId, version, locale])
}

// ---------------- PROVIDERS ----------------

model Provider {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String
  channel             Channel
  status              ProviderStatus @default(ACTIVE)
  probeLockedUntil    DateTime?
  priority            Int            @default(5)
  credentialRef       String?
  supportsIdempotency Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  healthRecords    ProviderHealth[]
  attempts         DeliveryAttempt[]
  deliveryEvents   DeliveryEvent[]
  metrics          NotificationMetric[]
  routingDecisions RoutingDecision[]

  @@unique([name, channel])
  @@index([channel, status])
}

model ProviderHealth {
  id             String         @id @default(uuid()) @db.Uuid
  providerId     String         @db.Uuid
  status         ProviderStatus
  successRate    Decimal        @db.Decimal(5, 4)
  avgLatencyMs   Int?
  costPerRequest Decimal?       @db.Decimal(12, 6)
  totalRequests  Int            @default(0)
  failedRequests Int            @default(0)
  checkedAt      DateTime       @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, checkedAt])
}

// ---------------- INTELLIGENT ROUTING ----------------

model RoutingDecision {
  id                    String   @id @default(uuid()) @db.Uuid
  notificationId        String   @db.Uuid
  notificationCreatedAt DateTime
  selectedProviderId    String?  @db.Uuid
  selectedChannel       Channel
  policyVersion         String
  reason                String
  decisionFactors       Json
  alternatives          Json?
  createdAt             DateTime @default(now())

  notification     Notification @relation(fields: [notificationId, notificationCreatedAt], references: [id, createdAt])
  selectedProvider Provider?    @relation(fields: [selectedProviderId], references: [id])

  @@index([notificationId, notificationCreatedAt, createdAt])
  @@index([selectedProviderId])
}

// ---------------- IDEMPOTENCY ----------------

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  requestHash  String
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseBody Json?
  statusCode   Int?
  expiresAt    DateTime
  lockedUntil  DateTime?
  leaseToken   String?           @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([scope, key])
  @@index([expiresAt])
}

// ---------------- TRANSACTIONAL OUTBOX ----------------

model OutboxMessage {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String?      @db.Uuid
  aggregateType String
  aggregateId   String
  topic         String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  lockedUntil   DateTime?
  leaseToken    String?      @db.Uuid
  leaseOwner    String?
  lastAttemptAt DateTime?
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([lockedUntil])
}

model ProcessedMessage {
  id           String   @id @default(uuid()) @db.Uuid
  consumerName String
  messageId    String
  processedAt  DateTime @default(now())

  @@unique([consumerName, messageId])
}

// ---------------- DEAD LETTERS ----------------

enum DeadLetterStatus {
  OPEN
  REPLAY_PENDING
  REPLAYED
  RESOLVED
  DISCARDED
}

model DeadLetterRecord {
  id             String           @id @default(uuid()) @db.Uuid
  source         String
  messageId      String
  payload        Json
  reason         String
  attempts       Int              @default(0)
  status         DeadLetterStatus @default(OPEN)
  replayCount    Int              @default(0)
  lastReplayAt   DateTime?
  resolutionNote String?
  failedAt       DateTime         @default(now())
  resolvedAt     DateTime?

  @@index([source, failedAt])
  @@index([status, failedAt])
  @@index([source, messageId])
}

// ---------------- DIGESTS ----------------

model DigestSchedule {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  frequency DigestFrequency
  weekday   Int?
  localTime String
  timezone  String
  isEnabled Boolean         @default(true)
  nextRunAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries DigestDelivery[]

  @@index([isEnabled, nextRunAt])
}

model DigestDelivery {
  id         String               @id @default(uuid()) @db.Uuid
  scheduleId String               @db.Uuid
  status     DigestDeliveryStatus @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime             @default(now())

  schedule DigestSchedule       @relation(fields: [scheduleId], references: [id])
  items    DigestDeliveryItem[]

  @@index([scheduleId, createdAt])
}

model DigestDeliveryItem {
  id                    String   @id @default(uuid()) @db.Uuid
  digestDeliveryId      String   @db.Uuid
  notificationId        String   @db.Uuid
  notificationCreatedAt DateTime

  digestDelivery DigestDelivery @relation(fields: [digestDeliveryId], references: [id], onDelete: Cascade)
  notification   Notification   @relation(fields: [notificationId, notificationCreatedAt], references: [id, createdAt])

  @@unique([digestDeliveryId, notificationId, notificationCreatedAt])
  @@index([notificationId, notificationCreatedAt])
}

// ---------------- ANALYTICS ----------------

model NotificationMetric {
  id             String   @id @default(uuid()) @db.Uuid
  metricDate     DateTime @db.Date
  channel        Channel
  providerId     String?  @db.Uuid
  sentCount      Int      @default(0)
  deliveredCount Int      @default(0)
  failedCount    Int      @default(0)
  avgLatencyMs   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider Provider? @relation(fields: [providerId], references: [id])

  @@index([metricDate, channel])
  @@index([providerId, metricDate])
}
